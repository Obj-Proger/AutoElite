{
  "$description": "AutoElite Noir Modern: the design tokens of the mobile application and the website, in the format of the W3C Design Tokens Community Group. The clients copy these values; a test checks that they match.",
  "color": {
    "$type": "color",
    "background": { "$value": "#0E0F11", "$description": "The page behind everything." },
    "surface": { "$value": "#1A1C20", "$description": "Cards, fields and panels." },
    "surfaceRaised": { "$value": "#23252A", "$description": "A surface above a surface, such as the highlighted card." },
    "border": { "$value": "#2A2C31", "$description": "Hairlines, dividers and the tracks of progress bars." },
    "text": { "$value": "#EDEAE3", "$description": "Body text and headings." },
    "textSecondary": { "$value": "#B7B2A8", "$description": "Supporting text." },
    "textMuted": { "$value": "#979288", "$description": "Labels and captions; at least 4.5:1 on every surface." },
    "accent": { "$value": "#C9A96E", "$description": "Champagne gold: primary actions, highlights, the active tab." },
    "accentHover": { "$value": "#E2C891", "$description": "The accent under the pointer or pressed." },
    "onAccent": { "$value": "#0E0F11", "$description": "Text and icons on the accent." },
    "success": { "$value": "#86C29A", "$description": "Passed, paid, confirmed." },
    "warning": { "$value": "#E0B661", "$description": "Due soon, needs attention." },
    "danger": { "$value": "#E5867A", "$description": "Failed, overdue, destructive actions." }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": "Unbounded", "$description": "Headings and large figures, weights 500 and 600." },
    "text": { "$value": "Inter", "$description": "Body text, labels and numbers, weights 400, 500 and 600." }
  },
  "fontSize": {
    "$type": "dimension",
    "caption": { "$value": { "value": 12, "unit": "px" } },
    "label": { "$value": { "value": 13, "unit": "px" } },
    "body": { "$value": { "value": 15, "unit": "px" } },
    "bodyLarge": { "$value": { "value": 17, "unit": "px" } },
    "title": { "$value": { "value": 20, "unit": "px" } },
    "headline": { "$value": { "value": 28, "unit": "px" } },
    "display": { "$value": { "value": 44, "unit": "px" } }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "xxl": { "$value": { "value": 32, "unit": "px" } },
    "page": { "$value": { "value": 22, "unit": "px" }, "$description": "The side margins of a phone screen." }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 10, "unit": "px" } },
    "md": { "$value": { "value": 14, "unit": "px" }, "$description": "Buttons and fields." },
    "lg": { "$value": { "value": 18, "unit": "px" }, "$description": "Cards." },
    "xl": { "$value": { "value": 22, "unit": "px" }, "$description": "The highlighted card." },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": { "value": 48, "unit": "px" }, "$description": "The height of buttons and fields." }
  }
}
