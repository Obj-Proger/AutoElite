<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The offline mode of the applications on a device: a SQLite database keeps what the user last read from the API and
    the actions they took without a network, which are sent to the API in order once it can be reached.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoElite.Client\AutoElite.Client.csproj" />
  </ItemGroup>

</Project>
