<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The client of the API for the applications of the school (MAUI and Blazor) and for other .NET clients. Its code is
    generated by Kiota from the OpenAPI document that the build of the API writes, on every build where the document
    has changed; the generated code is not kept in the repository, so it always matches the API.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RepositoryRoot>
    <ApiOpenApiDocument>$(RepositoryRoot)/src/AutoElite.API/obj/openapi.json</ApiOpenApiDocument>
    <KiotaOutputDirectory>$(MSBuildThisFileDirectory)obj/Kiota</KiotaOutputDirectory>
    <DotnetCommand Condition="'$(DOTNET_HOST_PATH)' != ''">&quot;$(DOTNET_HOST_PATH)&quot;</DotnetCommand>
    <DotnetCommand Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</DotnetCommand>
    <KiotaArguments>--language CSharp --class-name AutoEliteApiClient --namespace-name AutoElite.Client.Api</KiotaArguments>
    <KiotaArguments>$(KiotaArguments) --exclude-backward-compatible --clean-output --log-level Warning</KiotaArguments>
    <!-- The document has no server: the address of the API is given to the client (AutoEliteApiClientFactory). -->
    <KiotaArguments>$(KiotaArguments) --disable-validation-rules NoServerEntry</KiotaArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Kiota.Bundle" />
  </ItemGroup>

  <!-- Builds the API first, which writes the OpenAPI document; the client does not use its assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\AutoElite.API\AutoElite.API.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Generates the client when the document, the version of Kiota or this file has changed. -->
  <Target
    Name="GenerateApiClient"
    BeforeTargets="CoreCompile"
    Inputs="$(ApiOpenApiDocument);$(RepositoryRoot)/.config/dotnet-tools.json;$(MSBuildThisFileFullPath)"
    Outputs="$(KiotaOutputDirectory)/kiota-lock.json">
    <Error
      Condition="!Exists('$(ApiOpenApiDocument)')"
      Text="The OpenAPI document of the API was not found at $(ApiOpenApiDocument); build AutoElite.API first." />
    <Exec Command="$(DotnetCommand) tool restore" WorkingDirectory="$(RepositoryRoot)" StandardOutputImportance="low" />
    <Exec
      Command="$(DotnetCommand) kiota generate --openapi &quot;$(ApiOpenApiDocument)&quot; --output &quot;$(KiotaOutputDirectory)&quot; $(KiotaArguments)"
      WorkingDirectory="$(RepositoryRoot)"
      EnvironmentVariables="KIOTA_OFFLINE_ENABLED=true;KIOTA_TUTORIAL_ENABLED=false" />
  </Target>

  <!-- Compiles the generated code, whether this build generated it or an earlier one did. -->
  <Target Name="IncludeApiClient" AfterTargets="GenerateApiClient" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(KiotaOutputDirectory)/**/*.cs" />
      <Compile Include="$(KiotaOutputDirectory)/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
