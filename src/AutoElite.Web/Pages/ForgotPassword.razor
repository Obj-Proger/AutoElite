@page "/forgot-password"
@using AutoElite.Client.Api
@using AutoElite.Client.Api.Models
@inject Func<AutoEliteApiClient> CreateApi
@inject IStringLocalizer<WebTexts> L

@*
    Asking for a link to reset the password. The answer is the same whether the address belongs to an account or not,
    as the API's is, so that nobody learns from it who studies or works at the school.
*@
<PageTitle>@L["Forgot.Title"] · AutoElite</PageTitle>

<section class="page narrow">
    <div class="page-header">
        <a class="caption" href="sign-in">@L["Forgot.Back"]</a>
        <h1 class="headline">@L["Forgot.Title"]</h1>
    </div>
    @if (_isSent)
    {
        <p class="body-large">@L["Forgot.Sent"]</p>
    }
    else
    {
        <p class="secondary">@L["Forgot.Lead"]</p>
        <EditForm class="form" Model="_form" OnSubmit="SendAsync">
            <label class="label" for="email">@L["SignIn.Email"]</label>
            <InputText id="email" class="field" type="email" autocomplete="username" @bind-Value="_form.Email" />
            @if (_isMissing)
            {
                <p class="error" role="alert">@L["Forgot.Missing"]</p>
            }
            <Problems Failure="_failure" />
            <button class="button" type="submit" disabled="@_isBusy">@L["Forgot.Submit"]</button>
        </EditForm>
    }
</section>

@code {
    private readonly Request _form = new();
    private bool _isMissing;
    private bool _isBusy;
    private bool _isSent;
    private Exception? _failure;

    private async Task SendAsync()
    {
        _isMissing = string.IsNullOrWhiteSpace(_form.Email);
        _failure = null;
        if (_isMissing)
            return;

        _isBusy = true;
        try
        {
            await CreateApi().Api.V1.Auth.Password.Forgot.PostAsync(new RequestPasswordResetCommand { Email = _form.Email.Trim() });
            _isSent = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            _failure = exception;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class Request
    {
        public string Email { get; set; } = string.Empty;
    }
}
