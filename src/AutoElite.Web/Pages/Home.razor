@page "/"
@inject IStringLocalizer<WebTexts> L

@* The front page of the site, which leads to signing in or to the account of the signed-in user. *@
<PageTitle>AutoElite</PageTitle>

<section class="page hero">
    <span class="overline">@L["Home.Overline"]</span>
    <h1 class="display">AutoElite</h1>
    <p class="body-large secondary">@L["Home.Lead"]</p>
    <AuthorizeView>
        <Authorized>
            <p class="body-large">@L["Home.SignedIn"] <strong>@context.User.Identity?.Name</strong></p>
            <div><a class="button" href="account">@L["Home.Account"]</a></div>
        </Authorized>
        <NotAuthorized>
            <div><a class="button" href="sign-in">@L["Layout.SignIn"]</a></div>
        </NotAuthorized>
    </AuthorizeView>
    <div class="card highlight">
        <span class="overline">@L["Home.ComingTitle"]</span>
        <p class="body-large">@L["Home.ComingText"]</p>
    </div>
</section>
