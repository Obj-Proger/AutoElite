@inject IStringLocalizer<WebTexts> L

@* A new password, typed twice, with the rules it must follow; the API checks them again. *@
<EditForm class="form" Model="_form" OnSubmit="SubmitAsync">
    <label class="label" for="new-password">@L["Password.New"]</label>
    <InputText id="new-password" class="field" type="password" autocomplete="new-password" @bind-Value="_form.Password" />
    <span class="caption">@L["Password.Rules"]</span>
    <label class="label" for="repeat-password">@L["Password.Repeat"]</label>
    <InputText id="repeat-password" class="field" type="password" autocomplete="new-password" @bind-Value="_form.Repeat" />
    @if (_isEmpty)
    {
        <p class="error" role="alert">@L["Password.Missing"]</p>
    }
    else if (_isMismatch)
    {
        <p class="error" role="alert">@L["Password.Mismatch"]</p>
    }
    <Problems Failure="Failure" />
    <button class="button" type="submit" disabled="@IsBusy">@SubmitText</button>
</EditForm>

@code {
    private readonly NewPassword _form = new();
    private bool _isEmpty;
    private bool _isMismatch;

    /// <summary>Gets or sets the text of the button.</summary>
    [Parameter]
    [EditorRequired]
    public string SubmitText { get; set; } = string.Empty;

    /// <summary>Gets or sets a value indicating whether the password is being sent.</summary>
    [Parameter]
    public bool IsBusy { get; set; }

    /// <summary>Gets or sets the failure of sending the password, if it failed.</summary>
    [Parameter]
    public Exception? Failure { get; set; }

    /// <summary>Gets or sets what receives the password, once it is typed twice the same.</summary>
    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    private async Task SubmitAsync()
    {
        _isEmpty = string.IsNullOrEmpty(_form.Password);
        _isMismatch = !_isEmpty && _form.Password != _form.Repeat;
        if (_isEmpty || _isMismatch)
            return;

        await OnSubmit.InvokeAsync(_form.Password);
    }

    private sealed class NewPassword
    {
        public string Password { get; set; } = string.Empty;

        public string Repeat { get; set; } = string.Empty;
    }
}
