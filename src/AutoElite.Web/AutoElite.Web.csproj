<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The website of the school: Blazor WebAssembly, served as static files, which calls the API through the same
    generated client as the mobile application, in the same Noir Modern design (design/tokens.json).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The texts follow the language of the browser, in English or in Russian. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- index.html names the framework script and the import map by placeholders that the build fills in. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoElite.Client\AutoElite.Client.csproj" />
  </ItemGroup>

</Project>
