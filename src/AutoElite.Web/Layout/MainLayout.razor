@inherits LayoutComponentBase
@using AutoElite.Client.Authentication
@inject BrowserSession Session
@inject NavigationManager Navigation
@inject IStringLocalizer<WebTexts> L

@* The frame of every page: the bar with the brand and the account, then the page. *@
<div class="shell">
    <header class="topbar">
        <a class="brand" href="">AutoElite</a>
        <span class="topbar-note">@L["Layout.Tagline"]</span>
        <nav class="topbar-actions">
            <AuthorizeView>
                <Authorized>
                    <a class="topbar-link" href="account">@context.User.Identity?.Name</a>
                    <button class="button secondary small" type="button" disabled="@_isSigningOut" @onclick="SignOutAsync">
                        @L["Layout.SignOut"]
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a class="button small" href="sign-in">@L["Layout.SignIn"]</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>
    @if (_signOutFailed)
    {
        <p class="banner error" role="alert">@L["Layout.SignOutFailed"]</p>
    }
    <main>
        @Body
    </main>
</div>

@code {
    private bool _isSigningOut;
    private bool _signOutFailed;

    private async Task SignOutAsync()
    {
        _isSigningOut = true;
        _signOutFailed = false;
        try
        {
            await Session.SignOutAsync(CancellationToken.None);
            Navigation.NavigateTo("");
        }
        catch (HttpRequestException)
        {
            _signOutFailed = true;
        }
        finally
        {
            _isSigningOut = false;
        }
    }
}
