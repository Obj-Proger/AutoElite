<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, with the certificate authorities of the system. A debug build uses network_security_config_debug. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
