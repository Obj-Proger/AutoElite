<?xml version="1.0" encoding="utf-8"?>
<!--
  The configuration of a debug build: HTTPS everywhere, except the API of the development machine, which the emulator
  reaches at 10.0.2.2 over HTTP. A release build uses network_security_config, which allows no HTTP at all.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
