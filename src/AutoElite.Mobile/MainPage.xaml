<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AutoElite"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="12" VerticalOptions="Center">
        <Label Style="{StaticResource Display}" Text="AutoElite" HorizontalOptions="Center" />
        <Label x:Name="AddressLabel" Style="{StaticResource Caption}" HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>
