<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AutoElite.Mobile.Controls.StudentSearchView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:StudentSearch">

    <!-- The search of the students for a manager: the field, then the students found, each with how to reach them. -->
    <VerticalStackLayout Spacing="10">
        <Border Style="{StaticResource Field}">
            <Entry
                Text="{Binding Text}"
                Placeholder="{l:Text Students.Search}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                ReturnType="Search" />
        </Border>
        <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotice}">
            <Label Style="{StaticResource Secondary}" Text="{Binding Notice}" />
        </Border>
        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pages:ContactEntry">
                    <Border Style="{StaticResource Card}" SemanticProperties.Description="{Binding Name}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SurfaceRaised}"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding Initials}"
                                    FontFamily="TextSemiBold"
                                    TextColor="{StaticResource Accent}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Style="{StaticResource BodyLarge}" Text="{Binding Name}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Roles}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentView>
