<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ChatViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout x:Name="MessageList" Padding="{StaticResource PageMargin}" Spacing="10">
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotice}">
                    <Label Style="{StaticResource Secondary}" Text="{Binding Notice}" />
                </Border>
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Messages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:MessageEntry">
                            <Border Style="{StaticResource Card}" HorizontalOptions="{Binding Alignment}" MaximumWidthRequest="320">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource Caption}" Text="{Binding Sender}" IsVisible="{Binding IsTheirs}" />
                                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Text}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Time}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="16,10">
            <Border Style="{StaticResource Field}">
                <Editor
                    Text="{Binding Text}"
                    Placeholder="{l:Text Chat.Placeholder}"
                    AutoSize="TextChanges"
                    MaxLength="4000"
                    MaximumHeightRequest="140" />
            </Border>
            <Button Grid.Column="1" Text="{l:Text Chat.Send}" Command="{Binding SendCommand}" VerticalOptions="End" />
        </Grid>
    </Grid>

</ContentPage>
