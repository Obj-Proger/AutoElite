<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ChatViewModel"
    Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:Text Chat.Actions}" Command="{Binding ActionsCommand}" />
    </ContentPage.ToolbarItems>

    <!-- A chat on a phone or a narrow window, opened from the chats page; on a wide window it opens in its pane. -->
    <pages:ChatView />

</ContentPage>
