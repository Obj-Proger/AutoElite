<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ChatViewModel"
    Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:Text Chat.Actions}" Command="{Binding ActionsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto,Auto">
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout x:Name="MessageList" Padding="{StaticResource PageMargin}" Spacing="10">
                <Label Style="{StaticResource Secondary}" Text="{Binding Title}" IsVisible="{Binding ShowsFullName}" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotice}">
                    <Label Style="{StaticResource Secondary}" Text="{Binding Notice}" />
                </Border>
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Messages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:MessageEntry">
                            <Border Style="{StaticResource Card}" HorizontalOptions="{Binding Alignment}" MaximumWidthRequest="320">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TapCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource Caption}" Text="{Binding Sender}" IsVisible="{Binding IsTheirs}" />
                                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Text}" IsVisible="{Binding HasText}" />
                                    <VerticalStackLayout
                                        Spacing="6"
                                        IsVisible="{Binding HasFiles}"
                                        BindableLayout.ItemsSource="{Binding Files}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="pages:FileEntry">
                                                <Border
                                                    BackgroundColor="{StaticResource SurfaceRaised}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="10,6"
                                                    SemanticProperties.Description="{Binding Name}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Command}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <Image Source="icon_attach.png" WidthRequest="18" HeightRequest="18" />
                                                        <VerticalStackLayout Grid.Column="1">
                                                            <Label
                                                                Text="{Binding Name}"
                                                                TextColor="{StaticResource Accent}"
                                                                LineBreakMode="MiddleTruncation" />
                                                            <Label Style="{StaticResource Caption}" Text="{Binding Details}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Label Style="{StaticResource Caption}" Text="{Binding Time}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView Grid.Row="1" Orientation="Horizontal" IsVisible="{Binding HasPending}" Padding="16,6,16,0">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Pending}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:FileEntry">
                        <Border
                            BackgroundColor="{StaticResource SurfaceRaised}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,4,4,4">
                            <HorizontalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding Name}"
                                    MaximumWidthRequest="180"
                                    LineBreakMode="MiddleTruncation"
                                    VerticalOptions="Center" />
                                <Button
                                    Style="{StaticResource SecondaryButton}"
                                    Text="✕"
                                    Padding="8,0"
                                    MinimumHeightRequest="32"
                                    Command="{Binding Command}"
                                    SemanticProperties.Description="{l:Text Chat.RemoveFile}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,10">
            <ImageButton
                Source="icon_attach.png"
                WidthRequest="44"
                HeightRequest="44"
                Padding="10"
                VerticalOptions="End"
                Command="{Binding AttachCommand}"
                SemanticProperties.Description="{l:Text Chat.Attach}" />
            <Border Grid.Column="1" Style="{StaticResource Field}">
                <Editor
                    Text="{Binding Text}"
                    Placeholder="{l:Text Chat.Placeholder}"
                    AutoSize="TextChanges"
                    MaxLength="4000"
                    MaximumHeightRequest="140" />
            </Border>
            <Button Grid.Column="2" Text="{l:Text Chat.Send}" Command="{Binding SendCommand}" VerticalOptions="End" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                WidthRequest="24"
                HeightRequest="24"
                VerticalOptions="End"
                Margin="0,0,0,10" />
        </Grid>
    </Grid>

</ContentPage>
