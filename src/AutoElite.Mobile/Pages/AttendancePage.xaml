<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.AttendancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:AttendanceViewModel"
    Title="{l:Text Attendance.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14">
            <Label Style="{StaticResource Title}" Text="{Binding Topic}" />
            <Label Style="{StaticResource Secondary}" Text="{Binding Details}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotice}">
                <Label Style="{StaticResource Secondary}" Text="{Binding Notice}" />
            </Border>

            <Label Style="{StaticResource Caption}" Text="{l:Text Attendance.Hint}" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Students}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:AttendanceEntry">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Name}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Contract}" />
                                </VerticalStackLayout>
                                <Switch
                                    Grid.Column="1"
                                    IsToggled="{Binding IsPresent}"
                                    OnColor="{StaticResource Accent}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{l:Text Attendance.Save}" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
