<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.StudyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:StudyPage"
    Title="{l:Text Study.Title}"
    ControlTemplate="{StaticResource TabPage}"
    Shell.NavBarIsVisible="False">

    <!--
        The studies as rows: of a student, the practice tests, the contracts with their progress and payments, and the
        documents; of a theory instructor, the questions of the school for the tests.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="20,8,20,32" Spacing="8" MaximumWidthRequest="760">
            <controls:ListRow
                Icon="clipboard-check"
                Tone="Accent"
                Title="{l:Text Study.Tests}"
                Subtitle="{l:Text Study.TestsHint}"
                ShowsChevron="True"
                Command="{Binding OpenTestsCommand}"
                IsVisible="{Binding IsStudent}" />
            <controls:ListRow
                Icon="wallet"
                Tone="Success"
                Title="{l:Text Contracts.Title}"
                Subtitle="{l:Text Study.ContractsHint}"
                ShowsChevron="True"
                Command="{Binding OpenContractsCommand}"
                IsVisible="{Binding IsStudent}" />
            <controls:ListRow
                Icon="file-text"
                Title="{l:Text Documents.Title}"
                Subtitle="{l:Text Study.DocumentsHint}"
                ShowsChevron="True"
                Command="{Binding OpenDocumentsCommand}"
                IsVisible="{Binding IsStudent}" />
            <controls:ListRow
                Icon="book-open"
                Tone="Accent"
                Title="{l:Text Questions.Title}"
                Subtitle="{l:Text Study.QuestionsHint}"
                ShowsChevron="True"
                Command="{Binding OpenQuestionsCommand}"
                IsVisible="{Binding IsTheoryInstructor}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
