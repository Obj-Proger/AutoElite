<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.StudyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:StudyPage"
    Title="{l:Text Study.Title}">

    <!--
        The studies: of a student, the practice tests, the contracts with their progress and payments, and the
        documents; of a theory instructor, the questions of the school for the tests.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14">
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsStudent}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTestsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource Title}" Text="{l:Text Study.Tests}" />
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Study.TestsHint}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsStudent}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenContractsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource Title}" Text="{l:Text Contracts.Title}" />
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Study.ContractsHint}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsStudent}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDocumentsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource Title}" Text="{l:Text Documents.Title}" />
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Study.DocumentsHint}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsTheoryInstructor}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenQuestionsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource Title}" Text="{l:Text Questions.Title}" />
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Study.QuestionsHint}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
