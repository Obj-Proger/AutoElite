<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ExamPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ExamViewModel"
    Title="{l:Text Exam.Kind}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14">
            <Border Style="{StaticResource HighlightCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource Headline}" Text="{Binding Title}" />
                    <Label Style="{StaticResource Secondary}" Text="{Binding Details}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding State}" IsVisible="{Binding HasState}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource Caption}" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" />
            <Label Style="{StaticResource Overline}" Text="{l:Text Exam.Members}" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Members}">
                <BindableLayout.EmptyView>
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Exam.NoMembers}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:ExamMemberEntry">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Name}" />
                                    <Label Style="{StaticResource Secondary}" Text="{Binding Result}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Comment}" IsVisible="{Binding HasComment}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Text="{Binding ActionText}"
                                    Command="{Binding Command}"
                                    IsVisible="{Binding HasAction}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
