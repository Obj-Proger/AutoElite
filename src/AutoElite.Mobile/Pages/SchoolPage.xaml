<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.SchoolPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:SchoolViewModel"
    Shell.NavBarIsVisible="False">

    <!-- The address of the school the application works with, in the frame of the pages before signing in. -->
    <controls:AuthFrame>
        <VerticalStackLayout Spacing="16">
            <Label Style="{StaticResource Overline}" Text="{l:Text School.Overline}" />
            <Label Style="{StaticResource Headline}" Text="{l:Text School.Title}" />
            <Label Style="{StaticResource Secondary}" Text="{l:Text School.Hint}" />
            <Border Style="{StaticResource Field}">
                <Entry
                    Text="{Binding Address}"
                    Placeholder="{l:Text School.Placeholder}"
                    Keyboard="Url"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    ReturnType="Go"
                    ReturnCommand="{Binding ContinueCommand}" />
            </Border>
            <controls:NoticeBanner Text="{Binding Error}" Tone="Danger" />
            <Button Text="{l:Text Common.Continue}" Command="{Binding ContinueCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </controls:AuthFrame>

</ContentPage>
