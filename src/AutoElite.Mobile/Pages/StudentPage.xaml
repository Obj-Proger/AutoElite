<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.StudentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:StudentViewModel"
    Title="{l:Text Student.Title}">

    <!--
        The student for an instructor: the avatar, name and contacts with writing and calling, each contract on a
        highlighted card with its practice hours as a bar and the rest of its progress as rows with icons, then the
        lessons with the instructor as cards.
    -->
    <ScrollView>
        <controls:SupportingPane Padding="20,12,20,32" MaximumWidthRequest="1200" HorizontalOptions="Start">
            <VerticalStackLayout Spacing="16">
                <controls:PersonHeader
                    Name="{Binding Name}"
                    Details="{Binding Contacts}"
                    WriteCommand="{Binding WriteCommand}"
                    CallCommand="{Binding CallCommand}"
                    CanCall="{Binding HasPhone}" />

                <controls:NoticeBanner Text="{Binding Notice}" Tone="Warning" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding ContractEntries}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:StudentContractEntry">
                            <Border Style="{StaticResource HighlightCard}">
                                <VerticalStackLayout Spacing="14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontFamily="TextSemiBold" FontSize="17" Text="{Binding Course}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding State}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Style="{StaticResource BodyLarge}" Text="{Binding Practice}" />
                                        <ProgressBar Progress="{Binding PracticeProgress}" />
                                    </VerticalStackLayout>
                                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <controls:AppIcon
                                            Name="car"
                                            Size="18"
                                            Color="{DynamicResource TextMuted}"
                                            VerticalOptions="Start" />
                                        <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Driving}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding HasGroup}">
                                        <controls:AppIcon
                                            Name="users"
                                            Size="18"
                                            Color="{DynamicResource TextMuted}"
                                            VerticalOptions="Start" />
                                        <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Group}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <controls:AppIcon
                                            Name="clipboard-check"
                                            Size="18"
                                            Color="{DynamicResource TextMuted}"
                                            VerticalOptions="Start" />
                                        <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Tests}" />
                                    </Grid>
                                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasExams}">
                                        <Label
                                            Style="{StaticResource Overline}"
                                            TextColor="{DynamicResource TextMuted}"
                                            Text="{l:Text Student.Exams}" />
                                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Exams}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Label Style="{StaticResource Secondary}" Text="{Binding .}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasLessons}">
                    <Label Style="{StaticResource Title}" Text="{l:Text Student.Lessons}" Margin="0,6,0,0" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Lessons}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pages:StudentLessonEntry">
                                <Border Style="{StaticResource Card}" Padding="16,14">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <controls:IconTile Icon="car" Tone="Accent" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label FontFamily="TextSemiBold" FontSize="15" Text="{Binding Time}" />
                                            <Label FontSize="13" TextColor="{DynamicResource TextMuted}" Text="{Binding Outcome}" />
                                            <Label Style="{StaticResource Caption}" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </controls:SupportingPane>
    </ScrollView>

</ContentPage>
