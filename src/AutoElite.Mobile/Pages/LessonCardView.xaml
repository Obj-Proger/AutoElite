<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AutoElite.Mobile.Pages.LessonCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:NextLessonCard">

    <!--
        A lesson on a highlighted card: what the card shows, such as the next lesson, with how long until it starts or
        ends, its times and kind, what it is, who and where, its state, then its main action and a second one: the only
        other action, or More for several. Today shows its next lesson so, and the schedule the lesson chosen in a day.
    -->
    <Border Style="{StaticResource HighlightCard}" Padding="20">
        <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Style="{StaticResource Overline}" Text="{Binding Caption}" VerticalOptions="Center" />
                <controls:StatusPill Grid.Column="1" Text="{Binding Countdown}" Tone="{Binding CountdownTone}" />
            </Grid>
            <VerticalStackLayout Spacing="2">
                <Label FontFamily="DisplaySemiBold" FontSize="30" Text="{Binding Time}" />
                <Label Style="{StaticResource Secondary}" Text="{Binding Kind}" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <controls:AppIcon Name="{Binding TitleIcon}" Size="18" Color="{DynamicResource TextMuted}" />
                <Label Grid.Column="1" Style="{StaticResource BodyLarge}" Text="{Binding Title}" />
            </Grid>
            <Label Style="{StaticResource Secondary}" Text="{Binding Details}" />
            <Label Style="{StaticResource Caption}" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button Text="{Binding Main.Text}" Command="{Binding Main.Command}" IsVisible="{Binding HasMain}" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Text="{Binding MoreText}"
                    Command="{Binding MoreCommand}"
                    IsVisible="{Binding HasMore}" />
            </Grid>
        </VerticalStackLayout>
    </Border>

</ContentView>
