<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ProfileViewModel"
    Title="{l:Text Profile.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14">
            <Border Style="{StaticResource HighlightCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Border
                        WidthRequest="72"
                        HeightRequest="72"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource Accent}"
                        VerticalOptions="Start">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Grid>
                            <Label
                                Text="{Binding Initials}"
                                FontFamily="TextSemiBold"
                                FontSize="26"
                                TextColor="{DynamicResource OnAccent}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <Image
                                Source="{Binding Photo}"
                                Aspect="AspectFill"
                                IsVisible="{Binding HasPhoto}"
                                SemanticProperties.Description="{l:Text Profile.Photo}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Style="{StaticResource Headline}" Text="{Binding Name}" />
                        <Label Style="{StaticResource Secondary}" Text="{Binding Email}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding Roles}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Text="{l:Text Profile.ChangePhoto}"
                            Command="{Binding ChangePhotoCommand}" />
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Text="{l:Text Profile.RemovePhoto}"
                            Command="{Binding RemovePhotoCommand}"
                            IsVisible="{Binding HasPhoto}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Profile.Details}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding LastName}" Placeholder="{l:Text Profile.LastName}" ReturnType="Next" />
                    </Border>
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding FirstName}" Placeholder="{l:Text Profile.FirstName}" ReturnType="Next" />
                    </Border>
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding MiddleName}" Placeholder="{l:Text Profile.MiddleName}" ReturnType="Next" />
                    </Border>
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding Phone}" Placeholder="{l:Text Profile.Phone}" Keyboard="Telephone" ReturnType="Done" />
                    </Border>
                    <Label Style="{StaticResource Caption}" Text="{l:Text Profile.PhoneHint}" />
                    <Label Style="{StaticResource Caption}" Text="{l:Text Profile.NotificationLanguage}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding NotificationLanguages}" SelectedIndex="{Binding NotificationLanguageIndex}" />
                    </Border>
                    <Label Style="{StaticResource Secondary}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
                    <Button Text="{l:Text Profile.Save}" Command="{Binding SaveCommand}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Security.Title}" />
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Profile.SecurityHint}" />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="{l:Text Profile.OpenSecurity}"
                        Command="{Binding SecurityCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Settings.School}" />
                    <Label Style="{StaticResource BodyLarge}" Text="{Binding School}" />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="{l:Text SignIn.ChangeSchool}"
                        Command="{Binding ChangeSchoolCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Settings.Language}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}" />
                    </Border>
                    <Label Style="{StaticResource Caption}" Text="{Binding LanguageNote}" IsVisible="{Binding HasLanguageNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Settings.Theme}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Settings.About}" />
                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Version}" />
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Settings.License}" />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="{l:Text Settings.SourceCode}"
                        Command="{Binding SourceCodeCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{l:Text Home.SignOut}" Command="{Binding SignOutCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
