<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:NotificationsViewModel"
    Title="{l:Text Notifications.Title}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{StaticResource Accent}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="12">
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotice}">
                    <Label Style="{StaticResource Secondary}" Text="{Binding Notice}" />
                </Border>

                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="{l:Text Notifications.ReadAll}"
                    Command="{Binding ReadAllCommand}"
                    IsVisible="{Binding HasUnread}" />

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:NotificationEntry">
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ReadCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Style="{StaticResource BodyLarge}" Text="{Binding Title}" />
                                        <Ellipse
                                            Grid.Column="1"
                                            Fill="{StaticResource Accent}"
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsUnread}" />
                                    </Grid>
                                    <Label Style="{StaticResource Secondary}" Text="{Binding Body}" IsVisible="{Binding HasBody}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Time}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
