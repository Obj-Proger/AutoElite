<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:NotificationsViewModel"
    Title="{l:Text Notifications.Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:Text Notifications.ReadAll}" Command="{Binding ReadAllCommand}" />
    </ContentPage.ToolbarItems>

    <!--
        The notifications: all of them or the unread ones, by days, each with the icon of what it is about, its title,
        text and how long ago it came; an unread one stands on a card with a dot. Touching one marks it read and opens
        what it is about.
    -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{DynamicResource Accent}">
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,24" Spacing="4" MaximumWidthRequest="760">
                <Border Style="{StaticResource SegmentBar}" Margin="4,0,4,10">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Button Style="{StaticResource Segment}" Text="{l:Text Notifications.All}" Command="{Binding ShowAllCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ShowsAll}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Text}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource Segment}"
                            Text="{Binding UnreadFilter}"
                            Command="{Binding ShowUnreadCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ShowsUnreadOnly}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Text}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>

                <controls:NoticeBanner Text="{Binding Notice}" Tone="Warning" Margin="4,0,4,8" />

                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Groups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:NotificationGroup">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Style="{StaticResource Overline}"
                                    TextColor="{DynamicResource TextMuted}"
                                    Text="{Binding Title}"
                                    Margin="16,12,16,4" />
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="pages:NotificationEntry">
                                            <Border
                                                Padding="16,14"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 18"
                                                BackgroundColor="Transparent">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsUnread}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                    <controls:IconTile Icon="{Binding Icon}" Tone="{Binding Tone}" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                        <Label
                                                            FontFamily="TextSemiBold"
                                                            FontSize="15"
                                                            TextColor="{DynamicResource TextSecondary}"
                                                            Text="{Binding Title}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource Text}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            FontSize="14"
                                                            TextColor="{DynamicResource TextMuted}"
                                                            Text="{Binding Body}"
                                                            IsVisible="{Binding HasBody}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            FontSize="12"
                                                            TextColor="{DynamicResource TextMuted}"
                                                            Text="{Binding Time}" />
                                                    </VerticalStackLayout>
                                                    <Ellipse
                                                        Grid.Column="2"
                                                        Fill="{DynamicResource Accent}"
                                                        WidthRequest="8"
                                                        HeightRequest="8"
                                                        VerticalOptions="Start"
                                                        Margin="0,6,0,0"
                                                        IsVisible="{Binding IsUnread}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <controls:EmptyState Icon="bell" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
