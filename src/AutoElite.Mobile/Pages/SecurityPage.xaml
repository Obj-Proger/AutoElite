<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:SecurityViewModel"
    Title="{l:Text Security.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Security.Password}" />
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Text="{Binding CurrentPassword}"
                            Placeholder="{l:Text Security.CurrentPassword}"
                            IsPassword="True"
                            ReturnType="Next" />
                    </Border>
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding NewPassword}" Placeholder="{l:Text Password.New}" IsPassword="True" ReturnType="Next" />
                    </Border>
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Text="{Binding RepeatedPassword}"
                            Placeholder="{l:Text Password.Repeat}"
                            IsPassword="True"
                            ReturnType="Go"
                            ReturnCommand="{Binding ChangePasswordCommand}" />
                    </Border>
                    <Label Style="{StaticResource Caption}" Text="{l:Text Password.Rules}" />
                    <Label Style="{StaticResource Caption}" Text="{l:Text Security.OtherDevices}" />
                    <Label Style="{StaticResource Secondary}" Text="{Binding PasswordMessage}" IsVisible="{Binding HasPasswordMessage}" />
                    <Button Text="{l:Text Security.ChangePassword}" Command="{Binding ChangePasswordCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Overline}" Text="{l:Text Security.Email}" />
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Text="{Binding NewEmail}"
                            Placeholder="{l:Text Security.NewEmail}"
                            Keyboard="Email"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            ReturnType="Next" />
                    </Border>
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Text="{Binding EmailPassword}"
                            Placeholder="{l:Text Security.CurrentPassword}"
                            IsPassword="True"
                            ReturnType="Go"
                            ReturnCommand="{Binding ChangeEmailCommand}" />
                    </Border>
                    <Label Style="{StaticResource Caption}" Text="{l:Text Security.EmailHint}" />
                    <Label Style="{StaticResource Secondary}" Text="{Binding EmailMessage}" IsVisible="{Binding HasEmailMessage}" />
                    <Button Text="{l:Text Security.ChangeEmail}" Command="{Binding ChangeEmailCommand}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
