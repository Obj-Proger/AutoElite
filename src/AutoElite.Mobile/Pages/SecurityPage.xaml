<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:SecurityViewModel"
    Title="{l:Text Security.Title}">

    <!-- The password and the email address, opened from the profile: each field under its caption. -->
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="24" MaximumWidthRequest="560">
            <VerticalStackLayout Spacing="14">
                <Label
                    Style="{StaticResource Overline}"
                    TextColor="{DynamicResource TextMuted}"
                    Text="{l:Text Security.Password}" />
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource Caption}" Text="{l:Text Security.CurrentPassword}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding CurrentPassword}" IsPassword="True" ReturnType="Next" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource Caption}" Text="{l:Text Password.New}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding NewPassword}" IsPassword="True" ReturnType="Next" />
                    </Border>
                    <Label Style="{StaticResource Caption}" Text="{l:Text Password.Rules}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource Caption}" Text="{l:Text Password.Repeat}" />
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Text="{Binding RepeatedPassword}"
                            IsPassword="True"
                            ReturnType="Go"
                            ReturnCommand="{Binding ChangePasswordCommand}" />
                    </Border>
                </VerticalStackLayout>
                <Label Style="{StaticResource Caption}" Text="{l:Text Security.OtherDevices}" />
                <controls:NoticeBanner Text="{Binding PasswordMessage}" />
                <Button Text="{l:Text Security.ChangePassword}" Command="{Binding ChangePasswordCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <Label
                    Style="{StaticResource Overline}"
                    TextColor="{DynamicResource TextMuted}"
                    Text="{l:Text Security.Email}" />
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource Caption}" Text="{l:Text Security.NewEmail}" />
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Text="{Binding NewEmail}"
                            Keyboard="Email"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            ReturnType="Next" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource Caption}" Text="{l:Text Security.CurrentPassword}" />
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Text="{Binding EmailPassword}"
                            IsPassword="True"
                            ReturnType="Go"
                            ReturnCommand="{Binding ChangeEmailCommand}" />
                    </Border>
                </VerticalStackLayout>
                <Label Style="{StaticResource Caption}" Text="{l:Text Security.EmailHint}" />
                <controls:NoticeBanner Text="{Binding EmailMessage}" />
                <Button Text="{l:Text Security.ChangeEmail}" Command="{Binding ChangeEmailCommand}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
