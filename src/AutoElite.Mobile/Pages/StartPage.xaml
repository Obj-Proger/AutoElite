<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.StartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="24" VerticalOptions="Center">
        <Label Style="{StaticResource Display}" Text="AutoElite" HorizontalOptions="Center" />
        <ActivityIndicator IsRunning="True" HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>
