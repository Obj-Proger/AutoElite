<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ExamResultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ExamResultViewModel"
    Title="{Binding Title}">

    <!--
        The result of a member of an exam: who and which exam, passed or failed as a choice of two, the score and a
        comment, each under its caption, then saving it.
    -->
    <ScrollView>
        <controls:PageColumn Padding="20,12,20,32" Spacing="16" MaximumWidthRequest="560">
            <Border Style="{StaticResource HighlightCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <controls:IconTile Icon="clipboard-check" Tone="Warning" />
                    <Label Grid.Column="1" Style="{StaticResource BodyLarge}" Text="{Binding Subject}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource Caption}" Text="{l:Text ExamResult.Outcome}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="{l:Text ExamResult.Passed}"
                        Command="{Binding PassedCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPassed}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Success}" />
                                <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Text="{l:Text ExamResult.Failed}"
                        Command="{Binding FailedCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFailed}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Danger}" />
                                <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Caption}" Text="{l:Text ExamResult.Score}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding Score}" Keyboard="Numeric" MaxLength="4" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Caption}" Text="{Binding CommentHint}" />
                <Border Style="{StaticResource Field}">
                    <Editor Text="{Binding Comment}" AutoSize="TextChanges" MaxLength="1000" />
                </Border>
            </VerticalStackLayout>

            <controls:NoticeBanner Text="{Binding Message}" Tone="Danger" />
            <Button Text="{l:Text ExamResult.Save}" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </controls:PageColumn>
    </ScrollView>

</ContentPage>
