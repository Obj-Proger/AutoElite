<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ExamResultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ExamResultViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14">
            <Border Style="{StaticResource HighlightCard}">
                <Label Style="{StaticResource BodyLarge}" Text="{Binding Subject}" />
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource Overline}" Text="{l:Text ExamResult.Outcome}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Text="{l:Text ExamResult.Passed}"
                            Command="{Binding PassedCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsPassed}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                                    <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Text="{l:Text ExamResult.Failed}"
                            Command="{Binding FailedCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                                    <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding Score}" Placeholder="{l:Text ExamResult.Score}" Keyboard="Numeric" MaxLength="4" />
                    </Border>
                    <Label Style="{StaticResource Caption}" Text="{Binding CommentHint}" />
                    <Border Style="{StaticResource Field}">
                        <Editor Text="{Binding Comment}" AutoSize="TextChanges" MaxLength="1000" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource ErrorText}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
            <Button Text="{l:Text ExamResult.Save}" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
