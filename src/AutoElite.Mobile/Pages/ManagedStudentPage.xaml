<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ManagedStudentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ManagedStudentViewModel"
    Title="{l:Text Student.Title}">

    <!--
        The student for a manager: the avatar, name and contacts with writing and calling, the driving lessons ahead,
        which are moved or cancelled from their rows, then each contract on a highlighted card with its money first,
        recording a payment when it is active, its progress and its payments; a payment that waits for its money has a
        button to confirm it.
    -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{DynamicResource Accent}">
        <ScrollView>
            <controls:PageColumn Padding="20,12,20,32" Spacing="16" MaximumWidthRequest="1200">
                <controls:PersonHeader
                    Name="{Binding Name}"
                    Details="{Binding Contacts}"
                    WriteCommand="{Binding WriteCommand}"
                    CallCommand="{Binding CallCommand}"
                    CanCall="{Binding HasPhone}" />

                <controls:NoticeBanner Text="{Binding Notice}" Tone="Warning" />
                <controls:EmptyState Icon="wallet" Text="{Binding EmptyText}" HidesWithoutText="True" />

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasLessons}">
                    <Label Style="{StaticResource Title}" Text="{l:Text Today.Ahead}" />
                    <controls:AdaptiveGrid BindableLayout.ItemsSource="{Binding Lessons}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pages:LessonRow">
                                <controls:ListRow
                                    Icon="{Binding Icon}"
                                    Tone="{Binding Tone}"
                                    Title="{Binding Title}"
                                    Subtitle="{Binding Subtitle}"
                                    Trailing="{Binding Time}"
                                    TrailingDetail="{Binding Day}"
                                    ShowsChevron="True"
                                    Command="{Binding Command}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </controls:AdaptiveGrid>
                </VerticalStackLayout>

                <controls:AdaptiveGrid
                    MinItemWidth="420"
                    MaxColumns="2"
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding ContractEntries}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:ManagedContractEntry">
                            <Border Style="{StaticResource HighlightCard}">
                                <VerticalStackLayout Spacing="14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Style="{StaticResource Overline}"
                                            TextColor="{DynamicResource TextMuted}"
                                            Text="{Binding Number}" />
                                        <Label FontFamily="TextSemiBold" FontSize="17" Text="{Binding Course}" />
                                    </VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <controls:IconTile Icon="wallet" Tone="Success">
                                            <controls:IconTile.Triggers>
                                                <DataTrigger TargetType="controls:IconTile" Binding="{Binding HasDebt}" Value="True">
                                                    <Setter Property="Tone" Value="Warning" />
                                                </DataTrigger>
                                            </controls:IconTile.Triggers>
                                        </controls:IconTile>
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource BodyLarge}"
                                            Text="{Binding Money}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasDebt}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                    <Button
                                        Text="{l:Text Payment.Add}"
                                        Command="{Binding AddPaymentCommand}"
                                        IsVisible="{Binding CanAddPayment}" />
                                    <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                                    <VerticalStackLayout Spacing="8">
                                        <Label Style="{StaticResource Secondary}" Text="{Binding Practice}" />
                                        <ProgressBar Progress="{Binding PracticeProgress}" />
                                    </VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <controls:AppIcon
                                            Name="book-open"
                                            Size="18"
                                            Color="{DynamicResource TextMuted}"
                                            VerticalOptions="Start" />
                                        <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Theory}" />
                                    </Grid>
                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPayments}">
                                        <Label
                                            Style="{StaticResource Overline}"
                                            TextColor="{DynamicResource TextMuted}"
                                            Text="{l:Text Payments.Title}" />
                                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Payments}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="pages:PaymentEntry">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Label
                                                            Style="{StaticResource Secondary}"
                                                            Text="{Binding Text}"
                                                            VerticalOptions="Center" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Text="{l:Text Payment.Confirm}"
                                                            Command="{Binding ConfirmCommand}"
                                                            IsVisible="{Binding CanConfirm}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </controls:AdaptiveGrid>
            </controls:PageColumn>
        </ScrollView>
    </RefreshView>

</ContentPage>
