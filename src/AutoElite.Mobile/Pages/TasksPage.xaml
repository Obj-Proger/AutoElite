<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:TasksViewModel"
    Title="{l:Text Tasks.Title}">

    <ScrollView>
        <controls:PageColumn Padding="20,8,20,32" MaximumWidthRequest="1200" Spacing="10">
            <Border Style="{StaticResource SegmentBar}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button Style="{StaticResource Segment}" Text="{l:Text Tasks.Open}" Command="{Binding ShowOpenCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowsOpen}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
                                <Setter Property="TextColor" Value="{DynamicResource Text}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource Segment}"
                        Text="{l:Text Tasks.Done}"
                        Command="{Binding ShowDoneCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowsDone}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
                                <Setter Property="TextColor" Value="{DynamicResource Text}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>
            <controls:NoticeBanner Text="{Binding Notice}" />
            <controls:EmptyState Icon="check" Text="{Binding EmptyText}" HidesWithoutText="True" />

            <controls:AdaptiveGrid BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:TaskEntry">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <controls:IconTile Icon="check" Tone="Accent">
                                    <controls:IconTile.Triggers>
                                        <DataTrigger TargetType="controls:IconTile" Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Icon" Value="triangle-alert" />
                                            <Setter Property="Tone" Value="Danger" />
                                        </DataTrigger>
                                    </controls:IconTile.Triggers>
                                </controls:IconTile>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label FontFamily="TextSemiBold" FontSize="15" Text="{Binding Title}" />
                                    <Label FontSize="13" TextColor="{DynamicResource TextMuted}" Text="{Binding Due}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Status}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <controls:AppIcon Grid.Column="2" Name="chevron-right" Size="18" Color="{DynamicResource TextMuted}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </controls:AdaptiveGrid>
        </controls:PageColumn>
    </ScrollView>

</ContentPage>
