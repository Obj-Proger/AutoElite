<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.TestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:TestsViewModel"
    Title="{l:Text Tests.Title}">

    <!--
        The tests of a student: the exams they are admitted to, the practice tests on highlighted cards and their past
        attempts as rows, which open their review.
    -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{DynamicResource Accent}">
        <ScrollView>
            <controls:PageColumn Padding="20,8,20,32" Spacing="12" MaximumWidthRequest="1200">
                <controls:NoticeBanner Text="{Binding Notice}" />

                <Label Style="{StaticResource Title}" Text="{l:Text Exams.Title}" IsVisible="{Binding HasExams}" />
                <controls:AdaptiveGrid MinItemWidth="320" BindableLayout.ItemsSource="{Binding Exams}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:TestEntry">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <controls:IconTile Icon="clipboard-check" Tone="Warning" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label FontFamily="TextSemiBold" FontSize="15" Text="{Binding Title}" />
                                            <Label FontSize="13" TextColor="{DynamicResource TextMuted}" Text="{Binding Details}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Button Text="{Binding ActionText}" Command="{Binding Command}" IsVisible="{Binding HasAction}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </controls:AdaptiveGrid>

                <Label Style="{StaticResource Title}" Text="{l:Text Tests.Practice}" Margin="0,6,0,0" />
                <controls:AdaptiveGrid MinItemWidth="320" BindableLayout.ItemsSource="{Binding Templates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:TestEntry">
                            <Border Style="{StaticResource HighlightCard}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <controls:IconTile Icon="book-open" Tone="Accent" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label FontFamily="TextSemiBold" FontSize="15" Text="{Binding Title}" />
                                            <Label FontSize="13" TextColor="{DynamicResource TextMuted}" Text="{Binding Details}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Button Text="{Binding ActionText}" Command="{Binding Command}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </controls:AdaptiveGrid>

                <Label Style="{StaticResource Title}" Text="{l:Text Tests.Attempts}" IsVisible="{Binding HasAttempts}" Margin="0,6,0,0" />
                <controls:AdaptiveGrid MinItemWidth="360" BindableLayout.ItemsSource="{Binding Attempts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:TestEntry">
                            <controls:ListRow
                                Icon="check"
                                Title="{Binding Title}"
                                Subtitle="{Binding Details}"
                                Trailing="{Binding ActionText}"
                                ShowsChevron="True"
                                Command="{Binding Command}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </controls:AdaptiveGrid>
            </controls:PageColumn>
        </ScrollView>
    </RefreshView>

</ContentPage>
