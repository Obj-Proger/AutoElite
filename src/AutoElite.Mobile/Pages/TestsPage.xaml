<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.TestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:TestsViewModel"
    Title="{l:Text Tests.Title}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{StaticResource Accent}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14">
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNotice}">
                    <Label Style="{StaticResource Secondary}" Text="{Binding Notice}" />
                </Border>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Templates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:TestEntry">
                            <Border Style="{StaticResource HighlightCard}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource Title}" Text="{Binding Title}" />
                                    <Label Style="{StaticResource Secondary}" Text="{Binding Details}" />
                                    <Button Text="{Binding ActionText}" Command="{Binding Command}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Style="{StaticResource Title}" Text="{l:Text Tests.Attempts}" IsVisible="{Binding HasAttempts}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Attempts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:TestEntry">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Title}" />
                                    <Label Style="{StaticResource Secondary}" Text="{Binding Details}" />
                                    <Button
                                        Style="{StaticResource SecondaryButton}"
                                        Text="{Binding ActionText}"
                                        Command="{Binding Command}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
