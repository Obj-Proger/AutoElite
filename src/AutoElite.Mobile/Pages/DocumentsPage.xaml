<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:DocumentsViewModel"
    Title="{l:Text Documents.Title}">

    <!--
        The documents of the student: their own, which they add and delete, then those of each contract; each is a card
        with the icon of a file that opens it.
    -->
    <ScrollView>
        <controls:PageColumn Padding="20,8,20,32" Spacing="12" MaximumWidthRequest="1200">
            <controls:NoticeBanner Text="{Binding Notice}" />

            <Label Style="{StaticResource Title}" Text="{l:Text Documents.Mine}" />
            <Label Style="{StaticResource Secondary}" Text="{l:Text Documents.MineHint}" />
            <Button Text="{l:Text Documents.Add}" Command="{Binding AddCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <controls:EmptyState Icon="file-text" Text="{l:Text Documents.NoneOfMine}" IsVisible="{Binding HasNoneOfMine}" />
            <controls:AdaptiveGrid BindableLayout.ItemsSource="{Binding Mine}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:DocumentEntry">
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Grid.GestureRecognizers>
                                <controls:IconTile Icon="file-text" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="TextSemiBold"
                                        FontSize="15"
                                        Text="{Binding Name}"
                                        LineBreakMode="MiddleTruncation" />
                                    <Label FontSize="13" TextColor="{DynamicResource TextMuted}" Text="{Binding Details}" />
                                </VerticalStackLayout>
                                <Grid
                                    Grid.Column="2"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    IsVisible="{Binding CanDelete}"
                                    SemanticProperties.Description="{l:Text Documents.Delete}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                                    </Grid.GestureRecognizers>
                                    <controls:AppIcon Name="x" Size="18" Color="{DynamicResource TextMuted}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </controls:AdaptiveGrid>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding HasContracts}" BindableLayout.ItemsSource="{Binding Contracts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:DocumentGroup">
                        <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                            <Label Style="{StaticResource Title}" Text="{Binding Title}" />
                            <controls:AdaptiveGrid BindableLayout.ItemsSource="{Binding Documents}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pages:DocumentEntry">
                                        <Border Style="{StaticResource Card}" Padding="16,12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                                </Grid.GestureRecognizers>
                                                <controls:IconTile Icon="file-text" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label
                                                        FontFamily="TextSemiBold"
                                                        FontSize="15"
                                                        Text="{Binding Name}"
                                                        LineBreakMode="MiddleTruncation" />
                                                    <Label FontSize="13" TextColor="{DynamicResource TextMuted}" Text="{Binding Details}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </controls:AdaptiveGrid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </controls:PageColumn>
    </ScrollView>

</ContentPage>
