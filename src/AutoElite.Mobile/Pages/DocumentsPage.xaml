<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:DocumentsViewModel"
    Title="{l:Text Documents.Title}">

    <!-- The documents of the student: their own, which they add and delete, then those of each contract. -->
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="12">
            <Label Style="{StaticResource Caption}" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" />

            <Label Style="{StaticResource Title}" Text="{l:Text Documents.Mine}" />
            <Label Style="{StaticResource Secondary}" Text="{l:Text Documents.MineHint}" />
            <Button Text="{l:Text Documents.Add}" Command="{Binding AddCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Style="{StaticResource Caption}" Text="{l:Text Documents.NoneOfMine}" IsVisible="{Binding HasNoneOfMine}" />
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Mine}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:DocumentEntry">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Name}" TextColor="{StaticResource Accent}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Details}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Text="{l:Text Documents.Delete}"
                                    Command="{Binding DeleteCommand}"
                                    IsVisible="{Binding CanDelete}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding HasContracts}" BindableLayout.ItemsSource="{Binding Contracts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:DocumentGroup">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource Title}" Text="{Binding Title}" />
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Documents}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pages:DocumentEntry">
                                        <Border Style="{StaticResource Card}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Style="{StaticResource BodyLarge}"
                                                    Text="{Binding Name}"
                                                    TextColor="{StaticResource Accent}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Details}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
