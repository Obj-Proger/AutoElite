<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:HomeViewModel"
    Shell.NavBarIsVisible="False"
    ControlTemplate="{StaticResource TabPage}">

    <!--
        Today: what matters most first. The lesson going on or the next one in the highlighted card, the figures of the
        role of the user, what needs their attention, then the following lessons as rows; what to do with a lesson is
        offered when its row is tapped. Pulling the page down sends the waiting actions and reads everything again.
    -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{DynamicResource Accent}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="14" MaximumWidthRequest="760">
                <controls:NoticeBanner Text="{Binding Status}" Tone="Warning" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasRefusals}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource ErrorText}" Text="{l:Text Home.Refused}" />
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Refusals}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Style="{StaticResource Secondary}" Text="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Text="{l:Text Home.Dismiss}"
                            Command="{Binding DismissRefusalsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The lesson going on or the next one. -->
                <Border Style="{StaticResource HighlightCard}" Padding="20" IsVisible="{Binding HasNext}">
                    <ContentView BindingContext="{Binding Next}">
                        <VerticalStackLayout x:DataType="pages:NextLessonCard" Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Style="{StaticResource Overline}" Text="{l:Text Today.Next}" VerticalOptions="Center" />
                                <controls:StatusPill Grid.Column="1" Text="{Binding Countdown}" Tone="{Binding CountdownTone}" />
                            </Grid>
                            <VerticalStackLayout Spacing="2">
                                <Label FontFamily="DisplaySemiBold" FontSize="30" Text="{Binding Time}" />
                                <Label Style="{StaticResource Secondary}" Text="{Binding Kind}" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <controls:AppIcon Name="{Binding TitleIcon}" Size="18" Color="{DynamicResource TextMuted}" />
                                <Label Grid.Column="1" Style="{StaticResource BodyLarge}" Text="{Binding Title}" />
                            </Grid>
                            <Label Style="{StaticResource Secondary}" Text="{Binding Details}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Text="{Binding Main.Text}" Command="{Binding Main.Command}" IsVisible="{Binding HasMain}" />
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Text="{l:Text Today.More}"
                                    Command="{Binding MoreCommand}"
                                    IsVisible="{Binding HasMore}" />
                            </Grid>
                        </VerticalStackLayout>
                    </ContentView>
                </Border>

                <!-- A student: the progress and the debt of their contract, and booking. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasContract}">
                    <controls:StatTile
                        Title="{l:Text Lesson.Driving}"
                        Value="{Binding DrivingHours}"
                        Unit="{Binding CourseHours}"
                        Progress="{Binding DrivingProgress}" />
                    <controls:StatTile
                        Grid.Column="1"
                        Title="{l:Text Today.Theory}"
                        Value="{Binding TheoryAttended}"
                        Unit="{l:Text Today.Attended}" />
                </Grid>
                <controls:ListRow
                    Icon="wallet"
                    Tone="Warning"
                    Title="{Binding Debt}"
                    Subtitle="{Binding DebtContract}"
                    ShowsChevron="True"
                    Command="{Binding OpenContractsCommand}"
                    IsVisible="{Binding HasDebt}" />
                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="{l:Text Home.Book}"
                    Command="{Binding BookCommand}"
                    IsVisible="{Binding IsStudent}" />

                <!-- An instructor: the lessons of the day and the free slots. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsInstructor}">
                    <controls:StatTile
                        Title="{l:Text Today.Lessons}"
                        Value="{Binding LessonsHeld}"
                        Unit="{Binding LessonsOfDay}"
                        Progress="{Binding DayProgress}"
                        Tone="Success" />
                    <controls:StatTile
                        Grid.Column="1"
                        Title="{l:Text Today.Free}"
                        Value="{Binding FreeSlots}"
                        Unit="{l:Text Today.ThisWeek}"
                        IsVisible="{Binding IsDrivingInstructor}" />
                </Grid>

                <!-- A manager or an administrator: the leads. -->
                <Border Style="{StaticResource HighlightCard}" Padding="20" IsVisible="{Binding IsManager}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLeadsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource Overline}" Text="{l:Text Leads.Title}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontFamily="TextSemiBold"
                                FontSize="14"
                                TextColor="{DynamicResource AccentText}"
                                Text="{l:Text Today.Open}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontFamily="DisplaySemiBold"
                                    FontSize="34"
                                    TextColor="{DynamicResource AccentText}"
                                    Text="{Binding NewLeads}" />
                                <Label Style="{StaticResource Secondary}" Text="{l:Text Today.NewLeads}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <HorizontalStackLayout Spacing="6">
                                    <Label FontFamily="DisplaySemiBold" FontSize="34" Text="{Binding MyLeads}" />
                                    <Label
                                        Style="{StaticResource Secondary}"
                                        Text="{Binding LeadLimit}"
                                        VerticalOptions="End"
                                        Margin="0,0,0,7" />
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource Secondary}" Text="{l:Text Today.MyLeads}" />
                            </VerticalStackLayout>
                        </Grid>
                        <ProgressBar Progress="{Binding LeadsProgress}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The staff: the tasks. -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsStaff}">
                    <Label Style="{StaticResource Title}" Text="{l:Text Today.Attention}" Margin="0,6,0,0" />
                    <controls:ListRow
                        Icon="clipboard-check"
                        Tone="{Binding TasksTone}"
                        Title="{l:Text Tasks.Title}"
                        Subtitle="{Binding TasksSummary}"
                        Trailing="{Binding TasksCount}"
                        ShowsChevron="True"
                        Command="{Binding OpenTasksCommand}" />
                </VerticalStackLayout>

                <!-- The following lessons. -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsVisible="{Binding HasRows}">
                    <Label Style="{StaticResource Title}" Text="{l:Text Today.Ahead}" VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontFamily="TextSemiBold"
                        FontSize="14"
                        TextColor="{DynamicResource AccentText}"
                        Text="{l:Text Today.All}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenScheduleCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:LessonRow">
                            <controls:ListRow
                                Icon="{Binding Icon}"
                                Tone="{Binding Tone}"
                                Title="{Binding Title}"
                                Subtitle="{Binding Subtitle}"
                                Trailing="{Binding Time}"
                                ShowsChevron="{Binding HasCommand}"
                                Command="{Binding Command}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <controls:EmptyState
                    Icon="calendar"
                    Text="{l:Text Home.Empty}"
                    ActionText="{l:Text Home.Book}"
                    Command="{Binding EmptyCommand}"
                    IsVisible="{Binding HasNoLessons}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
