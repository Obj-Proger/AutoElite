<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:HomeViewModel"
    Shell.NavBarIsVisible="False">

    <!-- Pulling the page down sends the waiting actions and reads everything again. -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{StaticResource Accent}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="18">
                <VerticalStackLayout Spacing="2">
                    <Label Style="{StaticResource Secondary}" Text="{Binding Greeting}" />
                    <Label Style="{StaticResource Headline}" Text="{Binding Name}" />
                </VerticalStackLayout>

                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="{Binding NotificationsText}"
                    Command="{Binding NotificationsCommand}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasStatus}">
                    <Label Style="{StaticResource Secondary}" Text="{Binding Status}" />
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasRefusals}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource ErrorText}" Text="{l:Text Home.Refused}" />
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Refusals}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Style="{StaticResource Secondary}" Text="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Text="{l:Text Home.Dismiss}"
                            Command="{Binding DismissRefusalsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowsLessons}">
                    <Label Style="{StaticResource Title}" Text="{l:Text Home.Schedule}" />
                    <Button Text="{l:Text Home.Book}" Command="{Binding BookCommand}" IsVisible="{Binding IsStudent}" />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="{l:Text Home.Tests}"
                        Command="{Binding TestsCommand}"
                        IsVisible="{Binding IsStudent}" />
                    <Label Style="{StaticResource Secondary}" Text="{l:Text Home.Empty}" IsVisible="{Binding HasNoLessons}" />
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Lessons}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pages:ScheduleEntry">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Overline}" Text="{Binding Kind}" />
                                        <Label Style="{StaticResource Title}" Text="{Binding Title}" />
                                        <Label Style="{StaticResource BodyLarge}" Text="{Binding Time}" />
                                        <Label Style="{StaticResource Secondary}" Text="{Binding Details}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
                                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Actions}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="pages:EntryAction">
                                                    <Button
                                                        Style="{StaticResource SecondaryButton}"
                                                        Text="{Binding Text}"
                                                        Command="{Binding Command}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="{l:Text Home.SignOut}"
                    Command="{Binding SignOutCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
