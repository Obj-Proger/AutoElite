<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.QuestionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:QuestionsViewModel"
    Title="{l:Text Questions.Title}">

    <!--
        The questions of the school for the tests: a search with a new question beside it, how many match, then each
        question as a card with its topic and whether it is in new tests; more are read on request.
    -->
    <ScrollView>
        <controls:PageColumn Padding="20,8,20,32" Spacing="12" MaximumWidthRequest="840">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Style="{StaticResource Field}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:AppIcon Name="search" Size="18" Color="{DynamicResource TextMuted}" />
                        <Entry
                            Grid.Column="1"
                            Text="{Binding Search}"
                            Placeholder="{l:Text Questions.Search}"
                            ReturnType="Search"
                            ReturnCommand="{Binding SearchCommand}" />
                    </Grid>
                </Border>
                <Button Grid.Column="1" Text="{l:Text Questions.New}" Command="{Binding NewCommand}" />
            </Grid>
            <Label Style="{StaticResource Caption}" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" />
            <controls:EmptyState Icon="book-open" Text="{Binding EmptyText}" HidesWithoutText="True" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:QuestionEntry">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <controls:IconTile Icon="book-open" Tone="Accent" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label
                                        FontFamily="TextSemiBold"
                                        FontSize="15"
                                        Text="{Binding Text}"
                                        MaxLines="3"
                                        LineBreakMode="TailTruncation" />
                                    <Label FontSize="13" TextColor="{DynamicResource TextMuted}" Text="{Binding Details}" />
                                    <Label
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Status}"
                                        TextColor="{DynamicResource AccentText}" />
                                </VerticalStackLayout>
                                <controls:AppIcon Grid.Column="2" Name="chevron-right" Size="18" Color="{DynamicResource TextMuted}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                Style="{StaticResource SecondaryButton}"
                Text="{l:Text Questions.More}"
                Command="{Binding MoreCommand}"
                IsVisible="{Binding HasMore}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </controls:PageColumn>
    </ScrollView>

</ContentPage>
