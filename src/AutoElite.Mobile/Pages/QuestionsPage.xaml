<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.QuestionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:QuestionsViewModel"
    Title="{l:Text Questions.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageMargin}" Spacing="10">
            <Button Text="{l:Text Questions.New}" Command="{Binding NewCommand}" />
            <Border Style="{StaticResource Field}">
                <Entry
                    Text="{Binding Search}"
                    Placeholder="{l:Text Questions.Search}"
                    ReturnType="Search"
                    ReturnCommand="{Binding SearchCommand}" />
            </Border>
            <Label Style="{StaticResource Caption}" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:QuestionEntry">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Style="{StaticResource BodyLarge}"
                                    Text="{Binding Text}"
                                    MaxLines="3"
                                    LineBreakMode="TailTruncation" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Details}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Status}" TextColor="{StaticResource Accent}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                Style="{StaticResource SecondaryButton}"
                Text="{l:Text Questions.More}"
                Command="{Binding MoreCommand}"
                IsVisible="{Binding HasMore}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
