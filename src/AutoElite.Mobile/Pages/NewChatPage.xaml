<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.NewChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:NewChatViewModel"
    Title="{l:Text NewChat.Title}">

    <ScrollView>
        <controls:PageColumn Padding="20,8,20,32" MaximumWidthRequest="840" Spacing="10">
            <Border Style="{StaticResource Field}">
                <Entry
                    Text="{Binding Search}"
                    Placeholder="{l:Text NewChat.Search}"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    ReturnType="Search" />
            </Border>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <controls:NoticeBanner Text="{Binding Notice}" />
            <controls:EmptyState Icon="users" Text="{Binding EmptyText}" HidesWithoutText="True" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:ContactEntry">
                        <Border Style="{StaticResource Card}" SemanticProperties.Description="{Binding Name}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:Avatar Name="{Binding Name}" Size="40" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label FontFamily="TextSemiBold" FontSize="15" Text="{Binding Name}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Roles}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </controls:PageColumn>
    </ScrollView>

</ContentPage>
