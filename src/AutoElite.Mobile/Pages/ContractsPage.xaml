<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.ContractsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:ContractsViewModel"
    Title="{l:Text Contracts.Title}">

    <!--
        The contracts of a student, each on a highlighted card: its number and course, then the money, the practice
        hours with a bar and the theory with the quality of the lessons as three tiles, side by side on a wide window,
        then the payments; under the contracts the past theory lessons with whether the student attended them.
    -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" RefreshColor="{DynamicResource Accent}">
        <ScrollView>
            <controls:PageColumn Padding="20,8,20,32" Spacing="14" MaximumWidthRequest="1200">
                <controls:NoticeBanner Text="{Binding Notice}" />
                <controls:EmptyState Icon="wallet" Text="{Binding EmptyText}" HidesWithoutText="True" />

                <controls:AdaptiveGrid MaxColumns="1" Spacing="14" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pages:ContractEntry">
                            <Border Style="{StaticResource HighlightCard}">
                                <VerticalStackLayout Spacing="18">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Style="{StaticResource Overline}"
                                            TextColor="{DynamicResource TextMuted}"
                                            Text="{Binding Number}" />
                                        <Label FontFamily="DisplaySemiBold" FontSize="20" Text="{Binding Course}" />
                                    </VerticalStackLayout>

                                    <!-- The money, the practice and the theory side by side on a wide window. -->
                                    <controls:AdaptiveGrid MinItemWidth="240" Spacing="12">
                                        <Border Style="{StaticResource Card}">
                                            <VerticalStackLayout Spacing="10">
                                                <controls:IconTile Icon="wallet" Tone="Success" />
                                                <Label Style="{StaticResource BodyLarge}" Text="{Binding Money}" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <VerticalStackLayout Spacing="10">
                                                <controls:IconTile Icon="car" Tone="Accent" />
                                                <Label Style="{StaticResource BodyLarge}" Text="{Binding Practice}" />
                                                <ProgressBar Progress="{Binding PracticeProgress}" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <VerticalStackLayout Spacing="10">
                                                <controls:IconTile Icon="book-open" />
                                                <Label Style="{StaticResource BodyLarge}" Text="{Binding Theory}" />
                                                <Label
                                                    Style="{StaticResource Secondary}"
                                                    Text="{Binding Quality}"
                                                    IsVisible="{Binding HasQuality}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </controls:AdaptiveGrid>

                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPayments}">
                                        <Label
                                            Style="{StaticResource Overline}"
                                            TextColor="{DynamicResource TextMuted}"
                                            Text="{l:Text Payments.Title}" />
                                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Payments}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <controls:AppIcon
                                                            Name="check"
                                                            Size="18"
                                                            Color="{DynamicResource Success}"
                                                            VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding .}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </controls:AdaptiveGrid>

                <!-- The past theory lessons with whether the student attended them. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasTheoryVisits}" Margin="0,8,0,0">
                    <Label Style="{StaticResource Title}" Text="{l:Text Study.TheoryLessons}" />
                    <controls:AdaptiveGrid MinItemWidth="340" Spacing="8" BindableLayout.ItemsSource="{Binding TheoryVisits}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pages:TheoryVisitEntry">
                                <controls:ListRow
                                    Icon="{Binding Icon}"
                                    Tone="{Binding Tone}"
                                    Title="{Binding Topic}"
                                    Subtitle="{Binding Details}"
                                    TrailingDetail="{Binding State}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </controls:AdaptiveGrid>
                </VerticalStackLayout>
            </controls:PageColumn>
        </ScrollView>
    </RefreshView>

</ContentPage>
