<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AutoElite.Mobile.Pages.CompletionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    x:DataType="pages:CompletionViewModel"
    Title="{l:Text Lesson.CompleteTitle}">

    <!--
        Completing a driving lesson: the student and the time, the hours driven, a grade of each skill and a note for
        the student, each under its caption, then completing it.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="16" MaximumWidthRequest="560">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <controls:Avatar Name="{Binding Student}" Size="48" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label FontFamily="TextSemiBold" FontSize="17" Text="{Binding Student}" />
                    <Label Style="{StaticResource Secondary}" Text="{Binding Time}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Caption}" Text="{l:Text Lesson.CompleteHours}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding Hours}" Keyboard="Numeric" />
                </Border>
            </VerticalStackLayout>
            <controls:NoticeBanner Text="{Binding Error}" Tone="Danger" />

            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource Caption}" Text="{l:Text Completion.Grades}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Skills}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pages:SkillGradeEntry">
                                <Grid ColumnDefinitions="*,88" ColumnSpacing="12" Padding="16,8">
                                    <Label Style="{StaticResource BodyLarge}" Text="{Binding Name}" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource Field}" Padding="10,0">
                                        <Picker
                                            ItemsSource="{x:Static pages:SkillGradeEntry.Choices}"
                                            SelectedIndex="{Binding Grade}"
                                            HorizontalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Caption}" Text="{l:Text Lesson.CompleteNote}" />
                <Border Style="{StaticResource Field}">
                    <Editor Text="{Binding Note}" AutoSize="TextChanges" MaxLength="2000" />
                </Border>
            </VerticalStackLayout>

            <Button Text="{l:Text Lesson.Complete}" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
