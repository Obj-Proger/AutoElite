<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoElite.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:AutoElite.Mobile.Localization"
    xmlns:pages="clr-namespace:AutoElite.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled">

    <!--
        The start page comes first and moves on to the address of the school, signing in or the tabs of the signed-in
        user, which replace each other; the other pages open over a tab, the profile from the avatar above every tab. The
        tab of studies is a student's and a theory instructor's, the tabs of students and of leads a manager's and an
        administrator's.
    -->
    <ShellContent ContentTemplate="{DataTemplate pages:StartPage}" Route="start" />
    <ShellContent ContentTemplate="{DataTemplate pages:SchoolPage}" Route="school" />
    <ShellContent ContentTemplate="{DataTemplate pages:SignInPage}" Route="sign-in" />

    <TabBar Route="main">
        <Tab Title="{l:Text Tab.Home}" Icon="tab_home.png" Route="home">
            <ShellContent ContentTemplate="{DataTemplate pages:HomePage}" />
        </Tab>
        <Tab Title="{l:Text Tab.Schedule}" Icon="tab_schedule.png" Route="schedule">
            <ShellContent ContentTemplate="{DataTemplate pages:SchedulePage}" />
        </Tab>
        <Tab x:Name="StudyTab" Title="{l:Text Tab.Study}" Icon="tab_study.png" Route="study" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate pages:StudyPage}" />
        </Tab>
        <Tab x:Name="StudentsTab" Title="{l:Text Tab.Students}" Icon="tab_students.png" Route="students" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate pages:StudentsPage}" />
        </Tab>
        <Tab x:Name="LeadsTab" Title="{l:Text Leads.Title}" Route="leads" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate pages:LeadsPage}" />
        </Tab>
        <Tab Title="{l:Text Tab.Chats}" Icon="tab_chats.png" Route="chats">
            <ShellContent ContentTemplate="{DataTemplate pages:ChatsPage}" />
        </Tab>
    </TabBar>

</Shell>
