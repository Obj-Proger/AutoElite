<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    The dark colors of Noir Modern, copied from the color group of design/tokens.json; the architecture tests check that
    they match. The pages take every color as a dynamic resource, so that AppPalette can put the light ones
    (ColorsLight.xaml) in their place while the application runs.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AutoElite.Mobile.Resources.Styles.DarkColors">

    <Color x:Key="Background">#0E0F11</Color>
    <Color x:Key="Surface">#1A1C20</Color>
    <Color x:Key="SurfaceRaised">#23252A</Color>
    <Color x:Key="Border">#2A2C31</Color>
    <Color x:Key="Text">#EDEAE3</Color>
    <Color x:Key="TextSecondary">#B7B2A8</Color>
    <Color x:Key="TextMuted">#979288</Color>
    <Color x:Key="Accent">#C9A96E</Color>
    <Color x:Key="AccentHover">#E2C891</Color>
    <Color x:Key="OnAccent">#0E0F11</Color>
    <Color x:Key="AccentText">#C9A96E</Color>
    <Color x:Key="Primary">#C9A96E</Color>
    <Color x:Key="PrimaryPressed">#E2C891</Color>
    <Color x:Key="OnPrimary">#0E0F11</Color>
    <Color x:Key="Highlight">#23252A</Color>
    <Color x:Key="HighlightBorder">#2A2C31</Color>
    <Color x:Key="Success">#86C29A</Color>
    <Color x:Key="Warning">#E0B661</Color>
    <Color x:Key="Danger">#E5867A</Color>

</ResourceDictionary>
