<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    The light colors of Noir Modern, copied from the colorLight group of design/tokens.json under the names of the dark
    ones (Colors.xaml); the architecture tests check that they match. AppPalette puts them in place of the dark ones.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AutoElite.Mobile.Resources.Styles.LightColors">

    <Color x:Key="Background">#F6F4EF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceRaised">#F1EEE7</Color>
    <Color x:Key="Border">#E4E0D7</Color>
    <Color x:Key="Text">#16171A</Color>
    <Color x:Key="TextSecondary">#4A4740</Color>
    <Color x:Key="TextMuted">#6B675F</Color>
    <Color x:Key="Accent">#C9A96E</Color>
    <Color x:Key="AccentHover">#B8914A</Color>
    <Color x:Key="OnAccent">#0E0F11</Color>
    <Color x:Key="AccentText">#7A5C24</Color>
    <Color x:Key="Primary">#E2D1AA</Color>
    <Color x:Key="PrimaryPressed">#D9C49A</Color>
    <Color x:Key="OnPrimary">#3D3322</Color>
    <Color x:Key="Highlight">#ECE7DE</Color>
    <Color x:Key="HighlightBorder">#ECE7DE</Color>
    <Color x:Key="Success">#2B6E44</Color>
    <Color x:Key="Warning">#8A5A00</Color>
    <Color x:Key="Danger">#B4412F</Color>

</ResourceDictionary>
