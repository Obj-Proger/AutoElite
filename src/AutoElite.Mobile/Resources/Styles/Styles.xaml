<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    The styles of Noir Modern (design/README.md). Controls look right without a style; text, buttons and cards take a
    named style for their role: Display, Headline, Title, BodyLarge, Secondary, Caption, ErrorText and Overline for labels,
    SecondaryButton, Field for the border around an entry, Card and HighlightCard. Colors are dynamic resources, so that
    the light theme can take the place of the dark one while the application runs (AppPalette).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AutoElite.Mobile.Controls">

    <x:Double x:Key="PageMargin">22</x:Double>
    <x:Double x:Key="TouchTarget">48</x:Double>

    <!--
        The pages of the tabs take the TabPage template: AppFrame puts the title, the bell and the avatar above them and
        the tabs below them on a phone or at their left in a window, the same on every platform. The tab bar of the
        shell is hidden, and so is its navigation bar on those pages; the pages opened over a tab keep it, with the way
        back.
    -->
    <ControlTemplate x:Key="TabPage">
        <controls:AppFrame>
            <ContentPresenter />
        </controls:AppFrame>
    </ControlTemplate>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Background}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Text}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Text}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource Background}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Accent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Text -->

    <!-- A named style replaces the implicit one, so every label style is based on this one. -->
    <Style x:Key="BaseLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="TextRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />

    <Style x:Key="Display" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="DisplaySemiBold" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="LineHeight" Value="1.05" />
    </Style>

    <Style x:Key="Headline" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="DisplaySemiBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="Title" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="DisplayMedium" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="BodyLarge" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="Secondary" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{DynamicResource Danger}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Overline" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
        <Setter Property="FontFamily" Value="TextMedium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="2" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <!-- Actions -->

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontFamily" Value="TextSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Border}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="BorderColor" Value="{DynamicResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="TextSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <!-- Input -->

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="TextRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="controls:FieldFocus.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="TextRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="controls:FieldFocus.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="TextRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="controls:FieldFocus.IsEnabled" Value="True" />
    </Style>

    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- Surfaces -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HighlightCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Highlight}" />
        <Setter Property="Stroke" Value="{DynamicResource HighlightBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Accent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Border}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Accent}" />
    </Style>

</ResourceDictionary>
