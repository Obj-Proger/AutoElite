<?xml version="1.0" encoding="utf-8"?>
<!--
  Every package comes from nuget.org and from nowhere else, whatever sources the machine has: a package of the same name
  on another source cannot take the place of the real one.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
